# ==========================================
# Store POS - Configuración de entorno
# Copia este archivo a .env y ajusta valores
# ==========================================

# Servidor API
API_PORT=8001
NODE_ENV=development

# Autenticación (OBLIGATORIO cambiar en producción)
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CORS (origen del frontend web / terminales LAN)
CORS_ORIGIN=http://127.0.0.1:5173

# Datos (Electron lo setea automáticamente en empaquetado)
# POS_DATA_DIR=